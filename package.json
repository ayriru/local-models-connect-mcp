{
  "name": "local-models-connect-mcp",
  "version": "0.1.0",
  "description": "MCP server connecting local model services (Unsloth Studio, etc.) via stdio, TOML-config driven",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "local-models",
    "unsloth",
    "openai-compatible"
  ],
  "bin": {
    "local-models-connect-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.7.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
